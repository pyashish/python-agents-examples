LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

LEMONSLICE_API_KEY=your_lemonslice_api_key

# LiveKit Inference — no Sarvam/Deepgram API keys (billed on your LiveKit Cloud project)
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=multi
LLM_MODEL=google/gemini-2.5-flash
TTS_MODEL=cartesia/sonic-3

# Your voice recorded in LiveKit Cloud: Voices → Custom voices → copy v_* ID
LIVEKIT_CUSTOM_VOICE_ID=

# Optional: built-in Cartesia voice if you skip custom clone
# TTS_VOICE=

# Optional: override default agent/assets/avatar.jpg
# AGENT_IMAGE_PATH=assets/avatar.jpg