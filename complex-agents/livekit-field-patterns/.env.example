# Copy to .env.local and fill in. Never commit .env.local.

# LiveKit Cloud project (also pays for LiveKit Inference STT, LLM and TTS)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Console mode: which sample call to run, inbound or outbound
CONSOLE_DIRECTION=inbound

# Shared secret the agent signs its end-of-call report with
CALL_REPORT_SECRET=

# Optional: call recording to S3
RECORDING_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
